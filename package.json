{
  "name": "campus-chat",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.105.0",
    "expo": "~58.0.26",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.10",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "api:dev": "node scripts/backend-command.mjs start:dev",
    "db:inspect": "node scripts/backend-command.mjs db:inspect",
    "db:provision": "node scripts/backend-command.mjs db:provision",
    "db:migrate": "node scripts/backend-command.mjs db:migrate",
    "demo:seed": "node scripts/backend-command.mjs seed:demo",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:web": "playwright test",
    "export:web": "expo export --platform web --output-dir dist/web",
    "export:all": "expo export --platform all --output-dir dist/app",
    "serve:web": "node scripts/serve-web.mjs",
    "package:submission": "node scripts/package-submission.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm --prefix backend run verify"
  },
  "engines": {
    "node": ">=22.13.0 <27"
  },
  "private": true
}
