generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  name            String         @unique(map: "users_name_unique")
  phone           String?
  passwordHash    String?
  isBot           Boolean        @default(false)
  bio             String?
  conversationIds String[]       @default([]) @db.ObjectId
  conversations   Conversation[] @relation(fields: [conversationIds], references: [id])
  messages        Message[]

  @@map("users")
}

model Conversation {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  name       String?
  type       String    // "DM" | "GROUP"
  createdAt  DateTime  @default(now())
  createdBy  String    @db.ObjectId
  // All service/provisioning writes set dm:<sorted IDs> or group:<UUID> explicitly.
  conversationKey String @unique(map: "conversation_key_unique")
  activityAt DateTime @default(now())
  lastMessageAt DateTime?
  lastMessageId String? @db.ObjectId
  lastMessagePreview String?
  unreadCounts Json @default("{}")
  participants_ids String[]  @map("userIds") @db.ObjectId
  users            User[]    @relation(fields: [participants_ids], references: [id])
  messages         Message[]

  @@index([participants_ids, activityAt, id], map: "conversation_participants_activity")
  @@map("conversations")
}

model Message {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  content        String?
  imageInfo      String?
  createdAt      DateTime     @default(now())
  senderId       String       @db.ObjectId
  sender         User         @relation(fields: [senderId], references: [id])
  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  status         Json
  // A non-null random default also permits unlimited legacy/internal messages.
  sendKey        String       @unique(map: "message_send_key_unique") @default(uuid())
  clientMessageId String?
  // Optional attachment (image or file). Null for plain text messages.
  fileId         String?      @db.ObjectId
  file           File?        @relation(fields: [fileId], references: [id])

  @@index([conversationId, createdAt, id], map: "message_conversation_time_id")
  @@index([fileId, conversationId], map: "message_file_conversation")
  @@map("messages")
}

// An uploaded image or file. Clients send it as base64 or as a URL the server downloads;
// either way the bytes are stored here as binary.
model File {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  mimeType   String
  size       Int       // size in bytes (decoded, not base64)
  kind       String    // "IMAGE" | "FILE"
  data       Bytes
  sourceUrl  String?   // the link it was downloaded from; null for base64 uploads
  uploadedBy String    @db.ObjectId
  createdAt  DateTime  @default(now())
  messages   Message[]

  @@index([uploadedBy, createdAt], map: "file_owner_time")
  @@map("files")
}
