# Local disposable demo only. Replace placeholders; do not reuse real credentials.
MONGO_USERNAME=chatadmin
MONGO_PASSWORD=replace_with_a_random_local_test_password
DATABASE_URL="mongodb://chatadmin:replace_with_a_random_local_test_password@127.0.0.1:27017/chatapp?authSource=admin&replicaSet=rs0&directConnection=true"
PORT=3000
BIND_HOST=127.0.0.1
NODE_ENV=development
# Off by default in code. Production forbids this flag and requires a trusted TLS proxy.
ALLOW_INSECURE_LOCAL_HTTP=true
TRUST_PROXY_HOPS=0
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
MONGO_SILENT_LOGS=true

# Positive bounded integers. Invalid/out-of-range values fail startup.
MAX_UPLOAD_MB=10
# Legacy message imageInfo stays below 6 MiB even at its maximum value (4).
MAX_INLINE_IMAGE_MB=2
MAX_IMAGE_PIXELS=16000000
REMOTE_FETCH_TIMEOUT_MS=15000
MAX_CONCURRENT_REQUESTS=64
MAX_CONCURRENT_UPLOADS=8
MAX_CONCURRENT_MEDIA_READS=2
REQUESTS_PER_MINUTE=300

# Never enable for submission unless intentionally testing the bounded demo bot.
BOT_MODE=false
BOT_INTERVAL_MS=30000
BOT_BATCH_SIZE=10

# Tests/seeding require an explicitly isolated loopback replica set, named test_*.
# Never set this to a persistent development database.
# TEST_DATABASE_URL="mongodb://127.0.0.1:27027/test_submission?replicaSet=rs0&directConnection=true"
# DEMO_USERNAME_A=demo_alice
# DEMO_USERNAME_B=demo_bob
# DEMO_PASSWORD_A=<explicit disposable test password>
# DEMO_PASSWORD_B=<different explicit disposable test password>

# Explicit migration only, after inspection, backup and stopping API writers:
# MIGRATION_ACKNOWLEDGE_BACKUP=true
# MIGRATION_CREDENTIALS_JSON={"<legacy_user_id>":"<new disposable password>"}
# npm run db:migrate -- --apply --review-token=<token printed by dry-run>
