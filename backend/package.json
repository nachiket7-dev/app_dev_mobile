{
  "name": "chat-app-backend",
  "version": "1.1.0",
  "description": "NestJS Chat Backend - Prisma + MongoDB + Swagger",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "docker:up": "docker compose up --build",
    "docker:up:bot": "BOT_MODE=true docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api",
    "start:dev": "nest start --watch",
    "start:dev:bot": "BOT_MODE=true nest start --watch",
    "start:prod": "node dist/main.js",
    "build": "nest build",
    "prisma:generate": "prisma generate",
    "db:provision": "node --require ts-node/register scripts/db-provision.cjs",
    "db:inspect": "node --require ts-node/register scripts/db-inspect.cjs",
    "db:migrate": "node --require ts-node/register scripts/db-migrate.cjs",
    "seed:demo": "node --require ts-node/register scripts/seed-demo.cjs",
    "lint": "eslint src scripts tests eslint.config.cjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run prisma:generate && npm run lint && npm run typecheck && npm test && npm run build",
    "test": "node --require ts-node/register --test tests/*.test.cjs",
    "test:integration": "node --require ts-node/register --test --test-concurrency=1 tests/integration/*.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "6.19.3",
    "bmp-ts": "1.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prisma": "6.19.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8.48.1"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.1"
    }
  }
}
